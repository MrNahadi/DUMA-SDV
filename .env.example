# Gemini settings for the Duma SDV co-pilot and vehicle report (ADR 0018).
# Copy this file to .env.local (git-ignored), fill in the key, and restart `npm run dev`.
# The key ends up in the local bundle: never publish a build made with a key.

# API key from Google AI Studio. Leave empty to run without AI.
GEMINI_API_KEY=

# Text model for the report summary, tips and proactive suggestions.
# Empty means the default, gemini-3.5-flash-lite.
GEMINI_MODEL=

# Live API model for real-time voice. Empty means the default, gemini-3.8-live.
GEMINI_LIVE_MODEL=
