{
  "name": "duma-sdv",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Duma SDV: a browser-based digital twin of a software-defined electric vehicle.",
  "author": "FNM",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "build": "vite build",
    "e2e": "playwright test",
    "format": "prettier --write .",
    "paper:figures": "playwright test --config paper/figures/playwright.config.ts",
    "paper:data": "vite build --config paper/data/vite.config.ts && node paper/data/.build/export.mjs",
    "paper": "npm run paper:data && cd paper && latexmk -pdf -interaction=nonstopmode -halt-on-error main.tex"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@google/genai": "2.24.0",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.8.0",
    "jspdf": "4.2.1",
    "lucide-react": "1.47.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "three": "0.186.0",
    "uplot": "1.6.32",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.11.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.1"
  }
}
